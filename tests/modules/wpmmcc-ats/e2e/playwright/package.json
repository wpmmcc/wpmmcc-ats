{
  "name": "e2e-v2-playwright",
  "private": true,
  "version": "1.0.0",
  "description": "E2E v2: official gate + support + audit Playwright lanes",
  "scripts": {
    "test": "npm run test:gate",
    "test:headed": "npm run test:gate:headed",
    "test:gate": "playwright test -c playwright.config.ts",
    "test:gate:headed": "playwright test -c playwright.config.ts --headed",
    "test:gate:plugin-side": "playwright test -c playwright.config.ts official-gate/plugin-task-simulation.gate.e2e.spec.ts --workers=1",
    "test:gate:client-execution": "playwright test -c playwright.config.ts official-gate/client-translate.execution.gate.e2e.spec.ts --workers=1",
    "test:gate:client-verification": "playwright test -c playwright.config.ts official-gate/client-translate.verification.gate.e2e.spec.ts --workers=1",
    "test:support:plugin-webui": "playwright test -c playwright.support-plugin-webui.config.ts",
    "test:support:plugin-admin-forms": "playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 14-admin-form-submit.spec.ts",
    "test:support:plugin-models-templates": "playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 15-models-templates-submit.spec.ts",
    "test:support:plugin-languages-seo-menu": "playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 16-languages-seo-menu-submit.spec.ts",
    "test:support:plugin-translate-save": "bash ../run-owned-wp-output.sh --manual-editor",
    "test:support:plugin-strings-tm": "playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 18-strings-tm-submit.spec.ts",
    "test:support:plugin-sites-relation": "playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 19-sites-relation-submit.spec.ts",
    "test:support:plugin-content-admin": "bash ../run-owned-wp-output.sh --content-admin",
    "test:support:plugin-content-matrix": "bash ../run-owned-wp-output.sh --content-matrix",
    "test:support:plugin-correspondence": "playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 22-source-translated-correspondence.spec.ts",
    "test:support:plugin-public-surfaces": "playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 23-public-surfaces-correspondence.spec.ts",
    "test:support:plugin-admin-bar": "playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 24-admin-bar-switcher.spec.ts",
    "test:support:plugin-admin-pages": "playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 25-admin-page-matrix.spec.ts",
    "test:support:plugin-ops-pack": "bash ../run-ops-pack-weekly.sh",
    "test:support:plugin-admin-ops": "npm run test:support:plugin-translate-save && npm run test:support:plugin-content-admin && playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 10-translation-meta-box.spec.ts 18-strings-tm-submit.spec.ts 19-sites-relation-submit.spec.ts",
    "test:support:plugin-admin-ops-full": "npm run test:support:plugin-translate-save && npm run test:support:plugin-content-admin && npm run test:support:plugin-content-matrix && playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 01-admin-render.spec.ts 10-translation-meta-box.spec.ts 18-strings-tm-submit.spec.ts 19-sites-relation-submit.spec.ts 22-source-translated-correspondence.spec.ts 23-public-surfaces-correspondence.spec.ts",
    "test:support:plugin-admin-render": "playwright test -c comprehensive/playwright.comprehensive.config.ts --workers=1 01-admin-render.spec.ts",
    "test:client-ui-setup:contracts": "playwright test -c playwright.client-ui-setup.config.ts contract-live.schema.spec.ts",
    "test:client-ui-setup:review": "bash ../run-playwright-support-client-local-ui.sh --review-owned",
    "test:client-ui-setup:surfaces": "playwright test -c playwright.client-ui-setup.config.ts pack-history-components.spec.ts",
    "test:client-ui-setup:journey-extras": "npm run test:client-ui-setup:review && playwright test -c playwright.client-ui-setup.config.ts pack-history-components.spec.ts form-validation.negative.spec.ts",
    "test:support:client-server": "bash ../run-playwright-support-client-server.sh",
    "test:support:client-server:official-templates": "bash ../run-playwright-support-client-server.sh support-client-server/component-template-test.spec.ts",
    "test:support:client-local-ui": "bash ../run-playwright-support-client-local-ui.sh",
    "test:support:client-mock": "bash ../run-playwright-support-client-mock.sh",
    "test:support:web-control-plane": "playwright test -c playwright.web-control-plane.config.ts",
    "test:journey:three-system": "bash ../run-playwright-journey-three-system.sh",
    "test:support:web-control-plane:headed": "playwright test -c playwright.web-control-plane.config.ts --headed",
    "test:audit:web-control-plane": "playwright test -c playwright.audit-web-control-plane.config.ts",
    "test:plugin-webui": "playwright test -c playwright.support-plugin-webui.config.ts",
    "test:client-webui": "playwright test -c playwright.config.ts",
    "test:client-local-ui": "bash ../run-playwright-support-client-local-ui.sh",
    "test:client-server-support": "bash ../run-playwright-support-client-server.sh",
    "test:client-server-support:official-templates": "bash ../run-playwright-support-client-server.sh support-client-server/component-template-test.spec.ts",
    "test:client-mock-support": "bash ../run-playwright-support-client-mock.sh",
    "test:simulation": "bash ../run-simulation-lane.sh",
    "test:simulation:auto-translate": "bash ../run-simulation-lane.sh simulation/sim-06-multi-config-list-filter.spec.ts simulation/sim-07-ats-auto-translate-immediate.spec.ts simulation/sim-08-dual-plugin-auto-translate-isolation.spec.ts",
    "test:simulation:visual": "bash ../run-simulation-lane.sh simulation/sim-09-visual-ui-audit.spec.ts",
    "test:client-ui-setup": "playwright test -c playwright.client-ui-setup.config.ts",
    "test:client-ui-setup:negative": "playwright test -c playwright.client-ui-setup.config.ts form-validation.negative.spec.ts",
    "test:web-control-plane": "playwright test -c playwright.web-control-plane.config.ts",
    "test:web-control-plane:headed": "playwright test -c playwright.web-control-plane.config.ts --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
