        "fields_source": "v4-scanner + wp_give_formmeta table verification",
        "fields_verified": "2026-01-27",
        "storage_note": "GiveWP stores form meta in custom table 'wp_give_formmeta', not wp_postmeta. Seeder creates give_forms CPT for discover/smoke; full formmeta via Give API is optional.",
