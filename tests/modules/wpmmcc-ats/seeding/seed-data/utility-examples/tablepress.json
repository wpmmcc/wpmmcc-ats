                ["三居室", "100-130㎡", "3", "2", "¥250-350万"],
                ["四居室", "140-180㎡", "4", "2-3", "¥400-550万"],
                ["复式", "180-250㎡", "4-5", "3-4", "¥600-900万"],
                ["别墅", "300+㎡", "5+", "4+", "¥1000万+"]
            ],
            "embed_config": {
                "post_types": ["property"],
                "embed_position": "after_content"
            }
        },
        {
            "name": "课程时间表",
            "slug": "course-schedule",
            "description": "课程安排时间表",
