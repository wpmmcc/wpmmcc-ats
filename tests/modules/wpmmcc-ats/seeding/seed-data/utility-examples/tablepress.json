{
    "_meta": {
        "plugin_slug": "tablepress",
        "plugin_name": "TablePress",
        "type": "tables",
        "version": "1.0.0",
        "description": "TablePress 表格数据配置"
    },

    "tables": [
        {
            "name": "产品规格对比表",
            "slug": "product-comparison",
            "description": "产品规格参数对比表格",
            "columns": ["特性", "基础版", "专业版", "企业版"],
            "data": [
                ["价格", "¥99/月", "¥299/月", "¥999/月"],
