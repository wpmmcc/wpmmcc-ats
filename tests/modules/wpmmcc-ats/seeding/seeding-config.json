    "official_data_sources": {
        "_description": "官方数据源配置",
        "base_path": "__SEED_OFFICIAL_DIR__",
        "plugins": {
            "wordpress-core": {
                "method": "wp_import",
                "file": "wordpress-core/themeunittestdata.wordpress.xml",
                "command": "wp import {file} --authors=create"
            },
            "woocommerce": {
                "method": "php_script",
                "file": "scripts/wc-csv-import.php",
                "command": "wp eval-file {file}"
            },
            "bbpress": {
                "method": "wp_import",
                "file": "downloads/bbpress/bbpress-sample-data.xml",
                "command": "wp import {file} --authors=create"
            },
            "easy-digital-downloads": {
                "method": "wp_import",
                "file": "easy-digital-downloads/sample-products-import.xml",
                "command": "wp import {file} --authors=create"
            },
            "buddypress": {
                "method": "wp_cli",
                "commands": [
                    "wp bp component activate groups",
                    "wp bp member generate --count=20",
                    "wp bp group generate --count=5"
                ]
            },
            "tutor": {
                "method": "wp_import",
                "file": "downloads/tutor-lms/tutor-sample-course.xml",
                "command": "wp import {file} --authors=create --skip=attachment"
            },
            "sensei-lms": {
                "method": "php_script",
                "file": "scripts/sensei-import.php",
                "command": "wp eval-file {file} --user=admin"
            },
            "lifterlms": {
                "method": "php_script",
                "file": "scripts/llms-json-import.php",
                "command": "wp eval-file {file} --user=admin"
            },
            "learnpress": {
                "method": "php_script",
                "file": "scripts/learnpress-seed.php",
                "command": "wp eval-file {file}"
            },
            "wp-easycart": {
                "method": "php_script",
                "file": "scripts/easycart-seed.php",
                "command": "wp eval-file {file} --user=admin"
            },
            "wpforo": {
                "method": "skip",
                "note": "WPForo 安装时自动创建示例数据，无需额外填充"
            }
        }
    },

